/website/.venv/

# Local Cloudflare development state
/website/.wrangler/
/website/.dev.vars*
/website/.env*
!/website/.dev.vars.example
!/website/.env*.example

# Derived catalogs, portable conformance projections, and packaged skill bundles
# (regenerated by `npm run docs:generate`; never commit)
/skills/*
# ...except the git-sync bridge skills (Arena session branch <-> local machine),
# which are hand-installed on this working branch and must be tracked so the
# local clone receives them (generated skills/reverse-engineer-anything stays ignored)
!/skills/README.md
!/skills/git-sync/
!/skills/computer-use/
!/skills/cloud-interop/
/docs/public/product-catalog.json
/docs/verification/managed-conformance-manifest.json
/docs/verification/managed-conformance-ledger.json

# Complete static website output, including generated language editions.
website/_site/
# Temporary translation output prepared before replacing the complete site.
website/.i18n-*/

# git-sync local-only outputs: pack.ps1 zips and Office lock files must never be
# picked up by the hands-free auto_push of the local watcher
/_export/
~$*
