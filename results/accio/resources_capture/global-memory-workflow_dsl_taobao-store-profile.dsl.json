{
  "schemaVersion": "agentwork.rpa.atomic.v1",
  "name": "Taobao managed merchant profile probe",
  "description": "Read-only merchant-page probe for an authenticated Taobao managed Profile Browser.",
  "defaults": {
    "timeoutMs": 25000,
    "retries": 0,
    "continueOnError": true,
    "stepGapMs": 2500
  },
  "steps": [
    {
      "id": "wait_for_merchant_page",
      "action": "waitTimeout",
      "ms": 8000
    },
    {
      "id": "read_title",
      "action": "readText",
      "target": [{ "by": "css", "value": "title", "nth": 0 }],
      "readMode": "innerText",
      "trim": true,
      "outputKey": "page_title",
      "onError": "continue"
    },

    {
      "id": "read_page_body",
      "action": "readText",
      "target": [{ "by": "css", "value": "body", "nth": 0 }],
      "readMode": "innerText",
      "trim": true,
      "outputKey": "page_body",
      "onError": "continue"
    },
    {
      "id": "read_qianniu_official_links",
      "action": "queryAll",
      "containerSelector": "a[href*='.taobao.com'],a[href*='.tmall.com']",
      "fields": {
        "text": {
          "text": true,
          "trim": true
        },
        "href": {
          "attr": "href",
          "trim": true
        }
      },
      "limit": 120,
      "outputKey": "official_links",
      "onError": "continue"
    }
  ]
}
