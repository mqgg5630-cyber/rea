{
  "schemaVersion": "agentwork.rpa.atomic.v1",
  "name": "1688 managed merchant profile probe",
  "description": "Read-only seller-workbench probe with bounded official 1688 links.",
  "defaults": {
    "timeoutMs": 25000,
    "retries": 0,
    "continueOnError": true,
    "stepGapMs": 2500
  },
  "steps": [
    {
      "id": "wait_for_workbench",
      "action": "waitTimeout",
      "ms": 8000
    },
    {
      "id": "read_title",
      "action": "readText",
      "target": [{ "by": "css", "value": "title", "nth": 0 }],
      "readMode": "innerText",
      "trim": true,
      "outputKey": "page_title",
      "onError": "continue"
    },
    {
      "id": "read_page_body",
      "action": "readText",
      "target": [{ "by": "css", "value": "body", "nth": 0 }],
      "readMode": "innerText",
      "trim": true,
      "outputKey": "page_body",
      "onError": "continue"
    },
    {
      "id": "read_merchant_identity_link",
      "action": "queryAll",
      "containerSelector": "a[href*='corp.1688.com/page/index.htm'][href*='memberId=']",
      "fields": {
        "text": { "text": true, "trim": true },
        "href": { "attr": "href", "trim": true }
      },
      "limit": 4,
      "outputKey": "merchant_identity_links",
      "onError": "continue"
    },
    {
      "id": "read_1688_links",
      "action": "queryAll",
      "containerSelector": "a[href*='.1688.com']",
      "fields": {
        "text": { "text": true, "trim": true },
        "href": { "attr": "href", "trim": true }
      },
      "limit": 80,
      "outputKey": "official_links",
      "onError": "continue"
    }
  ]
}
